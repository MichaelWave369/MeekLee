{
  "name": "meeklee-adventures",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Original endless and completely free React puzzle adventures, made for Mom.",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "build": "vite build && node scripts/build-sw.mjs",
    "check": "npm run family:check && node --check src/core.js && node --check scripts/build-sw.mjs && npm test && npm run build",
    "preview": "vite preview",
    "test:browser": "playwright test",
    "family:check": "node --check family/room-core.js && node --check family/worker.js",
    "family:dev": "npx --yes wrangler@4 dev --config family/wrangler.toml --port 8787",
    "family:deploy": "npx --yes wrangler@4 deploy --config family/wrangler.toml"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "7.1.10",
    "@playwright/test": "1.56.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
